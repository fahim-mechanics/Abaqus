    mask=('[#4 ]', ), )))
mdb.models['Model-1'].loads['Hx load'].setValues(traction=SHEAR)
mdb.models['Model-1'].loads['Hx load'].setValues(magnitude=-10000.0)
mdb.models['Model-1'].ShellEdgeLoad(createStepName='Loading', distributionType=
    UNIFORM, field='', localCsys=None, magnitude=2.5, name='Wn moment', region=
    Region(
